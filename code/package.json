{
  "name": "feather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "terminal": "node terminal-server.mjs",
    "dev:all": "node terminal-server.mjs & next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "cross-env ELECTRON_BUILD=1 next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static && electron-builder --mac --dir",
    "electron:dist": "cross-env ELECTRON_BUILD=1 next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static && electron-builder --mac"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.feathermail.app",
    "productName": "feather",
    "icon": "electron/icon.icns",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "prisma/**/*",
      "terminal-server.mjs",
      "tmux.conf",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      ".next/standalone/**/*",
      "terminal-server.mjs",
      "tmux.conf",
      "prisma/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "directories": {
      "output": "dist-electron"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.3.3",
    "googleapis": "^171.4.0",
    "isomorphic-dompurify": "^3.3.0",
    "next": "16.1.7",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
